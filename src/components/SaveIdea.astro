---
const { id } = Astro.props;
---
<button class="save-idea" data-save-id={id} aria-pressed="false" hidden><span aria-hidden="true">♡</span> <span data-save-label>Save idea</span></button>
<script>
  const key = 'hearth-saved-ideas';
  function read(): string[] { try { const value = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(value) ? value.filter(id => typeof id === 'string') : []; } catch { return []; } }
  function sync() {
    const saved = read();
    document.querySelectorAll<HTMLButtonElement>('[data-save-id]').forEach(button => {
      button.hidden = false;
      const selected = saved.includes(button.dataset.saveId!);
      button.setAttribute('aria-pressed', String(selected));
      button.querySelector('[data-save-label]')!.textContent = selected ? 'Saved' : 'Save idea';
    });
    document.querySelectorAll<HTMLElement>('[data-saved-card]').forEach(card => { card.hidden = !saved.includes(card.dataset.savedCard!); });
    const empty = document.querySelector<HTMLElement>('#saved-empty');
    if (empty) empty.hidden = [...document.querySelectorAll<HTMLElement>('[data-saved-card]')].some(card => !card.hidden);
  }
  document.addEventListener('click', event => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-save-id]');
    if (!button) return;
    const saved = read(); const id = button.dataset.saveId!;
    try { localStorage.setItem(key, JSON.stringify(saved.includes(id) ? saved.filter(item => item !== id) : [...saved,id])); sync(); }
    catch { button.querySelector('[data-save-label]')!.textContent = 'Saving unavailable'; }
  });
  window.addEventListener('storage', sync);
  window.addEventListener('pageshow', sync);
  sync();
</script>
