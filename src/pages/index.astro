---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import PostCard from '../components/PostCard.astro';
import SectionHead from '../components/SectionHead.astro';
import ExploreMore from '../components/ExploreMore.astro';
import {
  SITE,
  CATEGORIES,
  PRIMARY_CATEGORIES,
  SECONDARY_CATEGORIES,
  categoryName,
  formatDateShort,
  isPublished,
} from '../site';

const posts = (await getCollection('posts')).filter(isPublished).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featured?.id);
const freshStories = rest.slice(0, 6);
const freshIds = new Set(freshStories.map((post) => post.id));
const seasonalStories = posts
  .filter(
    (post) =>
      post.data.category === 'seasonal' &&
      post.id !== featured?.id &&
      !freshIds.has(post.id)
  )
  .slice(0, 4);
const usedIds = new Set([
  featured?.id,
  ...freshStories.map((post) => post.id),
  ...seasonalStories.map((post) => post.id),
]);
const archivePreview = posts.filter((post) => !usedIds.has(post.id)).slice(0, 10);

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
});

const origin = (Astro.site ?? new URL(SITE.url)).origin;
const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${origin}/#home`,
  name: 'Practical home decor ideas for real homes',
  description: SITE.description,
  isPartOf: { '@id': `${origin}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/post/${post.id}/`, origin).href,
      name: post.data.title,
    })),
  },
};
---

<Layout
  title="Home Decor Ideas for Real Homes"
  description="Practical home decor ideas, small-space solutions and room-by-room guides designed for beautiful, comfortable everyday living."
  imageWide={featured?.data.heroImage}
  schemas={[collectionSchema]}
>
  <div class="issue-strip border-b border-rule bg-sand/60">
    <div class="wrap flex items-center justify-between gap-5 py-2.5">
      <p class="text-eyebrow font-semibold uppercase text-ink-40">{today}</p>
      <a href="/stories/" class="text-eyebrow font-semibold uppercase text-ink-60 transition-colors hover:text-clay">
        Browse all {posts.length} stories
      </a>
    </div>
  </div>

  {featured && (
    <section class="home-hero" aria-labelledby="featured-story">
      <div class="wrap grid lg:grid-cols-12 lg:items-stretch">
        <a
          href={`/post/${featured.id}/`}
          class="group block overflow-hidden bg-sand lg:col-span-7"
          aria-label={`Read ${featured.data.title}`}
        >
          <div class="lead-photo aspect-[4/3] h-full min-h-[22rem] overflow-hidden lg:aspect-auto lg:min-h-[38rem]">
            <Img
              src={featured.data.heroImage}
              alt={featured.data.heroImageAlt ?? featured.data.title}
              width={1120}
              height={900}
              loading="eager"
              fetchpriority="high"
              sizes="(min-width: 1024px) 58vw, 100vw"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
            />
          </div>
        </a>

        <div class="home-hero-copy lg:col-span-5">
          <div>
            <p class="home-kicker">The considered home</p>
            <p class="mt-4 max-w-md text-sm leading-relaxed text-paper/70">
              Practical design guidance for rooms that feel collected, comfortable and entirely your own.
            </p>
          </div>

          <div class="my-10 h-px w-16 bg-clay lg:my-auto"></div>

          <div>
            <p class="text-eyebrow font-semibold uppercase tracking-[0.16em] text-clay-soft">
              Featured · {categoryName(featured.data.category)}
            </p>
            <h1 id="featured-story" class="mt-5 max-w-[15ch] font-display text-display-1 text-paper">
              <a href={`/post/${featured.id}/`} class="transition-colors hover:text-clay-soft">
                {featured.data.title}
              </a>
            </h1>
            <p class="mt-6 max-w-lg text-lead text-paper/75">{featured.data.description}</p>
            <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
              <a href={`/post/${featured.id}/`} class="btn bg-paper text-ink hover:bg-clay-soft">
                Read the story
              </a>
              <span class="text-xs uppercase tracking-[0.1em] text-paper/55">
                {formatDateShort(featured.data.publishDate)}
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="wrap mt-16 lg:mt-24" aria-labelledby="rooms-heading">
    <SectionHead
      id="rooms-heading"
      kicker="Find your starting point"
      title="Ideas for every room"
      href="/stories/"
      hrefLabel="View all stories"
    />

    <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
      {PRIMARY_CATEGORIES.map((category) => (
        <a href={`/category/${category.slug}/`} class="tile aspect-[3/4]">
          <Img
            src={category.image}
            alt=""
            width={340}
            height={453}
            sizes="(min-width: 1024px) 15vw, (min-width: 768px) 30vw, 45vw"
          />
          <span class="tile-label">{category.name}</span>
        </a>
      ))}
    </div>

    {SECONDARY_CATEGORIES.length > 0 && (
      <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-rule pt-6">
        <span class="eyebrow-muted shrink-0">More spaces</span>
        {SECONDARY_CATEGORIES.map((category) => (
          <a
            href={`/category/${category.slug}/`}
            class="link-underline font-display text-title text-ink hover:text-clay"
          >
            {category.name}
          </a>
        ))}
      </div>
    )}
  </section>

  {freshStories.length > 0 && (
    <section class="wrap mt-16 lg:mt-24" aria-labelledby="latest-heading">
      <SectionHead
        id="latest-heading"
        kicker="New this week"
        title="Fresh ideas to make your own"
        href="/stories/"
        hrefLabel="See the full archive"
      />
      <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {freshStories.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  {seasonalStories.length > 0 && (
    <section class="seasonal-edit mt-16 border-y border-rule bg-sand/65 py-16 lg:mt-24 lg:py-20" aria-labelledby="seasonal-heading">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-5">
            <p class="eyebrow">The seasonal edit</p>
            <h2 id="seasonal-heading" class="mt-3 max-w-[13ch] font-display text-display-2 text-ink">
              Timely details, thoughtfully done
            </h2>
          </div>
          <div class="lg:col-span-7 lg:pb-1">
            <p class="max-w-2xl text-lead text-ink-60">
              Simple ways to mark the season without losing the calm, lived-in character of your home.
            </p>
          </div>
        </div>

        <div class="mt-10 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
          {seasonalStories.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  {archivePreview.length > 0 && (
    <section class="wrap mt-16 lg:mt-24" aria-labelledby="archive-heading">
      <div class="archive-callout">
        <div class="archive-callout-copy">
          <p class="eyebrow text-clay-soft">The complete collection</p>
          <h2 id="archive-heading" class="mt-3 font-display text-display-3 text-paper">
            All {posts.length} published stories are now easy to find
          </h2>
          <p class="mt-4 max-w-xl text-paper/65">
            Search by room, topic or title, or simply browse every guide from newest to oldest.
          </p>
          <a href="/stories/" class="btn mt-7 bg-paper text-ink hover:bg-clay-soft">
            Explore all stories
          </a>
        </div>

        <div class="grid gap-x-8 gap-y-6 border-t border-paper/15 pt-8 lg:grid-cols-2 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
          {archivePreview.map((post) => (
            <article class="group border-b border-paper/15 pb-5">
              <p class="text-eyebrow font-semibold uppercase tracking-[0.15em] text-clay-soft">
                {categoryName(post.data.category)}
              </p>
              <h3 class="mt-2 font-display text-title-sm text-paper">
                <a href={`/post/${post.id}/`} class="transition-colors group-hover:text-clay-soft">
                  {post.data.title}
                </a>
              </h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="mt-16 lg:mt-24">
    <ExploreMore />
  </div>
</Layout>
