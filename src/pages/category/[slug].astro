---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Img from '../../components/Img.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ExploreMore from '../../components/ExploreMore.astro';
import { SITE, CATEGORIES, categoryBySlug, collectTags, isPublished, postPath } from '../../site';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = categoryBySlug(slug!)!;

const posts = (await getCollection('posts'))
  .filter(isPublished)
  .filter((p) => p.data.category === slug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const [lead, ...others] = posts;
const otherCategories = CATEGORIES.filter((c) => c.slug !== slug);

// Thin rooms were rendering a single card stranded in a three-column row with
// two-thirds of the row empty. Match the column count to what is actually left:
// one story reads better full-width, and two or four sit square in two columns.
const gridClass =
  others.length === 2 || others.length === 4
    ? 'sm:grid-cols-2'
    : 'sm:grid-cols-2 lg:grid-cols-3';

// Topic hubs that actually have posts in this room. Rooms and topics are the
// site's two axes; linking them here is what turns a flat archive into a
// graph a crawler can traverse in either direction.
const allPosts = (await getCollection('posts')).filter(isPublished);
const hubs = new Set(collectTags(allPosts, 3).map((t) => t.slug));
const topics = collectTags(posts, 1)
  .filter((t) => hubs.has(t.slug) && t.slug !== slug)
  .slice(0, 10);

// Give rooms with a small article collection a useful starting decision,
// rather than leaving visitors with only a photograph and one story card.
const startingPoints: Partial<Record<string, { heading: string; paragraphs: string[]; checks: string[] }>> = {
  kitchen: {
    heading: 'Start with the counter space you need',
    paragraphs: [
      'Before styling an island or adding display storage, set out the appliances, chopping boards and serving pieces you use on a normal day. The remaining clear surface is the space available for decoration. A tray can group objects, but it should lift away easily when you need to cook.',
      'Notice where people enter the kitchen, open drawers and set down groceries. Keep those routes and landing spots free. If a pendant, shelf or new fitting is part of the plan, check the actual dimensions and installation requirements before buying.',
    ],
    checks: ['What must stay within reach while cooking?', 'Which surface can remain clear for preparation?', 'Can the display be moved and cleaned easily?'],
  },
  entryway: {
    heading: 'Plan for the first minute at home',
    paragraphs: [
      'An entryway has to handle arrivals before it has to look styled. Open the front door fully, then mark the space used by shoes, bags and the people who pass through. A narrow console is useful only if it leaves that route comfortable.',
      'Give everyday items an obvious home: a bowl for keys, a place for wet shoes and a hook or stand for the coats actually worn this week. In a rental, check the lease and wall construction before mounting anything; a freestanding option may be easier to take away later.',
    ],
    checks: ['Does the door open without striking furniture?', 'Where do wet shoes and coats go?', 'Can everyone find keys on the way out?'],
  },
  'home-office': {
    heading: 'Choose a workable desk location',
    paragraphs: [
      'A small workspace needs room for the chair as well as the desk. Mark the desk footprint on the floor, then pull a chair back as you would to stand up. Check where daylight falls on the screen, where a lamp can plug in and whether the setup blocks a door or shared route.',
      'A closet can hide occasional work at the end of the day, but it needs enough depth for your knees, a safe power arrangement and suitable ventilation. A hallway console may work for a short laptop session; a full working day with a monitor usually needs more support and surface space.',
    ],
    checks: ['Can you pull the chair back freely?', 'Will daylight cause screen glare?', 'Where will cables, papers and equipment go after work?'],
  },
  renter: {
    heading: 'Choose changes that can move with you',
    paragraphs: [
      'Start with the lease, the surfaces you are allowed to alter and the time you expect to stay. Curtains, lamps, rugs and freestanding storage can change a room without a permanent finish. Adhesive products still need a discreet patch test, because paint condition and removal methods vary.',
      'Photograph the original condition before changing anything and keep fitting instructions and spare parts. If a shelf, blind or safety anchor needs a fixing, ask the landlord or property manager about the approved method rather than assuming every hole or adhesive is permitted.',
    ],
    checks: ['What does the lease allow?', 'Can the change be removed without damage?', 'Will the item fit and work in a future home?'],
  },
};
const startingPoint = startingPoints[slug!];

const origin = (Astro.site ?? new URL(SITE.url)).origin;

const listSchema = {
  '@type': 'CollectionPage',
  '@id': `${new URL(Astro.url.pathname, origin).href}#collection`,
  name: category.name,
  description: category.blurb,
  isPartOf: { '@id': `${origin}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(postPath(post), origin).href,
      name: post.data.title,
    })),
  },
};
---

<Layout
  title={`${category.name} Ideas`}
  description={category.blurb}
  image={lead?.data.pinImage}
  imageWide={lead?.data.heroImage ?? category.image}
  schemas={[listSchema]}
>
  <header class="border-b border-rule">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: category.name }]} />
      {/*
        The room's own photograph anchors the header — without it a category
        page opened from search is a wall of type, while every other template
        on the site leads with an image.
      */}
      <div class="mt-7 grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-14">
        <div class="lg:col-span-6">
          <h1 class="font-display text-display-1 text-ink">{category.name}</h1>
          <p class="mt-5 max-w-xl text-lead text-ink-60">{category.blurb}</p>
          <p class="mt-6 flex items-center gap-3 text-eyebrow font-semibold uppercase text-ink-40">
            <span class="rule-draw h-px w-8 bg-clay"></span>
            {posts.length} {posts.length === 1 ? 'story' : 'stories'}
          </p>
        </div>

        <div class="lg:col-span-6">
          <div class="frame lead-photo aspect-[16/10] lg:aspect-[3/2]">
            <Img
              src={category.image}
              alt=""
              width={860}
              height={573}
              loading="eager"
              fetchpriority="high"
              sizes="(min-width: 1024px) 45vw, 100vw"
            />
          </div>
        </div>
      </div>
    </div>
  </header>

  {startingPoint && (
    <section class="wrap border-b border-rule py-10 lg:py-14" aria-labelledby="room-start">
      <div class="max-w-reading">
        <p class="eyebrow text-clay">Start with the room you have</p>
        <h2 id="room-start" class="mt-3 font-display text-3xl text-ink">{startingPoint.heading}</h2>
        {startingPoint.paragraphs.map((paragraph) => (
          <p class="mt-4 leading-relaxed text-ink-60">{paragraph}</p>
        ))}
        <h3 class="mt-7 font-display text-xl text-ink">Three checks before you buy</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-60">
          {startingPoint.checks.map((check) => <li>{check}</li>)}
        </ul>
      </div>
    </section>
  )}

  {posts.length > 0 ? (
    <>
      <section class="wrap py-12 lg:py-16">
        <PostCard post={lead} variant="wide" eager sizes="(min-width: 640px) 45vw, 90vw" />

        {others.length === 1 && (
          <div class="mt-14 border-t border-rule pt-12">
            <PostCard post={others[0]} variant="wide" sizes="(min-width: 640px) 45vw, 90vw" />
          </div>
        )}

        {others.length > 1 && (
          <div class={`mt-14 grid gap-x-7 gap-y-12 border-t border-rule pt-12 ${gridClass}`}>
            {others.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )}
      </section>

    </>
  ) : (
    <section class="wrap py-20 text-center">
      <p class="font-display text-2xl text-ink">Nothing here yet.</p>
      <p class="mx-auto mt-3 max-w-md text-ink-60">
        We are working on this room. In the meantime, browse the rest of the archive.
      </p>
      <a href="/" class="btn btn-outline mt-7">Back to home</a>
    </section>
  )}

  {topics.length > 0 && (
    <section class="wrap border-t border-rule pt-10" aria-labelledby="room-topics">
      <h2 id="room-topics" class="eyebrow-muted">Topics in this room</h2>
      <div class="mt-5 flex flex-wrap gap-2">
        {topics.map((t) => (
          <a href={`/tag/${t.slug}/`} class="chip-link">{t.label}</a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap mt-10 border-t border-rule pt-10" aria-labelledby="other-rooms">
    <h2 id="other-rooms" class="eyebrow-muted">Other rooms</h2>
    <div class="mt-5 flex flex-wrap gap-x-7 gap-y-3">
      {otherCategories.map((c) => (
        <a href={`/category/${c.slug}/`} class="font-display text-xl text-ink transition-colors hover:text-clay sm:text-2xl">
          {c.name}
        </a>
      ))}
    </div>
  </section>

  <div class="mt-16 lg:mt-20">
    <ExploreMore />
  </div>
</Layout>
