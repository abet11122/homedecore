---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<section class={`bg-ink px-6 py-14 text-paper sm:px-12 sm:py-16 ${className}`}>
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-eyebrow font-semibold uppercase text-clay-soft">The Weekly Edit</p>
    <h2 class="mt-4 font-display text-3xl leading-tight text-paper sm:text-[2.5rem]">
      One room, studied properly — every Sunday.
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-[0.9375rem] leading-relaxed text-paper/70">
      No product dumps. Just one considered space, what makes it work, and where to find the pieces.
    </p>

    <form
      class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row"
      onsubmit="event.preventDefault(); this.querySelector('.msg').hidden = false;"
    >
      <label for="nl-email" class="sr-only">Email address</label>
      <input
        id="nl-email"
        type="email"
        required
        placeholder="your@email.com"
        class="min-w-0 flex-1 border border-paper/25 bg-transparent px-4 py-3 text-paper placeholder:text-paper/40 focus:border-clay focus:outline-none"
      />
      <button type="submit" class="btn bg-clay text-paper hover:bg-clay-deep">Subscribe</button>
      <p class="msg sr-only" hidden aria-live="polite">Thanks — connect a mail provider to finish setup.</p>
    </form>

    <p class="mt-4 text-xs text-paper/45">
      Demo form — see the README to connect ConvertKit, Buttondown or Mailchimp.
    </p>
  </div>
</section>
