---
import '../styles/global.css';
import { SITE, CATEGORIES, PRIMARY_CATEGORIES, SECONDARY_CATEGORIES } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  updatedDate?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishDate,
  updatedDate,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// og:image is the vertical pin when a post supplies one, so Pinterest saves
// the 2:3 image rather than the horizontal hero.
const ogImage = image
  ? image.startsWith('photo-')
    ? `https://images.unsplash.com/${image}?w=1000&h=1500&fit=crop&auto=format&q=75`
    : image
  : `https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=1200&h=630&fit=crop&auto=format&q=75`;

const adsenseId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || import.meta.env.ADSENSE_CLIENT_ID || '';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  sameAs: [SITE.pinterest, SITE.instagram],
};

const articleSchema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: [ogImage],
        datePublished: publishDate,
        dateModified: updatedDate || publishDate,
        author: { '@type': 'Person', name: SITE.author },
        publisher: { '@type': 'Organization', name: SITE.name },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#FBF8F4" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Fonts: preconnect + swap so text paints instantly and never reflows */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
    />

    {/* Open Graph — og:image is the vertical 2:3 pin on post pages */}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    {type === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Pinterest Rich Pins + domain verification */}
    <meta name="pinterest-rich-pin" content="true" />
    {SITE.pinterestVerification && (
      <meta name="p:domain_verify" content={SITE.pinterestVerification} />
    )}
    {SITE.googleVerification && (
      <meta name="google-site-verification" content={SITE.googleVerification} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    {/*
      Google Consent Mode v2 defaults — denied until the certified CMP
      (Privacy & messaging / UMP) records a choice. Required for EEA, UK and CH.
      See README → "GDPR consent" for the one line you paste to switch it on.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      >Skip to content</a
    >

    <header class="sticky top-0 z-30 border-b border-ink/15 bg-paper/92 backdrop-blur-md">
      {/* Thin clay rule across the very top — a masthead cue */}
      <div class="h-[3px] bg-clay"></div>

      <div class="wrap">
        <div class="flex h-[4.25rem] items-center justify-between gap-6 lg:h-[5.25rem]">
          <a href="/" class="shrink-0">
            <span class="block font-display text-[1.5rem] font-bold leading-none tracking-display text-ink lg:text-[1.75rem]">
              {SITE.name}
            </span>
            <span class="mt-1.5 hidden text-eyebrow font-semibold uppercase text-ink-40 lg:block">
              {SITE.tagline}
            </span>
          </a>

          {/*
            Only the six primary rooms sit inline — the archive has outgrown a
            flat nav. Everything else lives in the CSS-only "More" panel below,
            so the masthead stays on one line at every width.
          */}
          <nav class="hidden items-center gap-6 xl:gap-7 lg:flex" aria-label="Primary">
            {PRIMARY_CATEGORIES.map((c) => (
              <a
                href={`/category/${c.slug}/`}
                class="link-underline whitespace-nowrap font-body text-[0.8125rem] font-medium uppercase tracking-[0.11em] text-ink-60 hover:text-ink"
              >
                {c.name}
              </a>
            ))}

            <details class="relative [&[open]_svg]:rotate-180">
              <summary
                class="flex cursor-pointer list-none items-center gap-1.5 font-body text-[0.8125rem] font-medium uppercase tracking-[0.11em] text-ink-60 hover:text-ink [&::-webkit-details-marker]:hidden"
              >
                More
                <svg class="transition-transform" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m5 9 7 7 7-7"></path>
                </svg>
              </summary>
              <div class="absolute right-0 top-[calc(100%+1.15rem)] w-60 border border-rule bg-paper p-2 shadow-xl">
                {SECONDARY_CATEGORIES.map((c) => (
                  <a
                    href={`/category/${c.slug}/`}
                    class="block px-3 py-2.5 font-display text-[1.0625rem] text-ink transition-colors hover:bg-sand hover:text-clay"
                  >
                    {c.name}
                  </a>
                ))}
              </div>
            </details>
          </nav>

          <div class="flex items-center gap-2">
            <a
              href="/search/"
              aria-label="Search"
              class="grid h-10 w-10 place-items-center text-ink-60 transition-colors hover:text-clay"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
            </a>

            {/* CSS-only mobile menu — no JavaScript shipped */}
            <details class="lg:hidden [&_svg.close]:hidden [&[open]_svg.close]:block [&[open]_svg.open]:hidden">
              <summary
                class="grid h-10 w-10 cursor-pointer list-none place-items-center text-ink [&::-webkit-details-marker]:hidden"
                aria-label="Menu"
              >
                <svg class="open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                  <path d="M3 6h18M3 12h18M3 18h18"></path>
                </svg>
                <svg class="close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                  <path d="M5 5l14 14M19 5L5 19"></path>
                </svg>
              </summary>
              <div class="absolute inset-x-0 top-[calc(4.25rem+3px)] border-b border-rule bg-paper shadow-lg">
                <nav class="wrap grid gap-0 py-2" aria-label="Mobile">
                  {CATEGORIES.map((c) => (
                    <a
                      href={`/category/${c.slug}/`}
                      class="border-b border-rule/70 py-3.5 font-display text-lg text-ink last:border-0"
                    >
                      {c.name}
                    </a>
                  ))}
                  <a href="/about/" class="py-3.5 font-body text-sm uppercase tracking-[0.1em] text-ink-40">
                    About
                  </a>
                </nav>
              </div>
            </details>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-rule bg-sand">
      <div class="wrap py-16">
        <div class="grid gap-12 md:grid-cols-12">
          <div class="md:col-span-4">
            <p class="font-display text-2xl leading-tight text-ink">{SITE.name}</p>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-60">{SITE.description}</p>
            <div class="mt-6 flex gap-4">
              <a href={SITE.pinterest} rel="noopener noreferrer nofollow" target="_blank" class="eyebrow-muted hover:text-clay">Pinterest</a>
              <a href={SITE.instagram} rel="noopener noreferrer nofollow" target="_blank" class="eyebrow-muted hover:text-clay">Instagram</a>
              <a href={`mailto:${SITE.email}`} class="eyebrow-muted hover:text-clay">Email</a>
            </div>
          </div>

          <div class="md:col-span-4">
            <p class="eyebrow-muted">Rooms</p>
            {/* Two columns so the full category list stays a readable block */}
            <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2.5">
              {CATEGORIES.map((c) => (
                <li>
                  <a href={`/category/${c.slug}/`} class="text-sm text-ink-60 hover:text-clay">{c.name}</a>
                </li>
              ))}
            </ul>
          </div>

          <div class="md:col-span-2">
            <p class="eyebrow-muted">Site</p>
            <ul class="mt-4 space-y-2.5">
              <li><a href="/" class="text-sm text-ink-60 hover:text-clay">Home</a></li>
              <li><a href="/about/" class="text-sm text-ink-60 hover:text-clay">About</a></li>
              <li><a href="/contact/" class="text-sm text-ink-60 hover:text-clay">Contact</a></li>
              <li><a href="/search/" class="text-sm text-ink-60 hover:text-clay">Search</a></li>
            </ul>
          </div>

          <div class="md:col-span-2">
            <p class="eyebrow-muted">Legal</p>
            <ul class="mt-4 space-y-2.5">
              <li><a href="/privacy-policy/" class="text-sm text-ink-60 hover:text-clay">Privacy Policy</a></li>
              <li><a href="/disclosure/" class="text-sm text-ink-60 hover:text-clay">Disclosure</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-14 flex flex-col gap-3 border-t border-rule pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-ink-40">
            © {new Date().getFullYear()} {SITE.name}. All rights reserved.
          </p>
          <p class="text-xs text-ink-40">
            As an Amazon Associate we earn from qualifying purchases.
          </p>
        </div>
      </div>
    </footer>

    <slot name="after-footer" />

    {/* AdSense — deferred so it never competes with the main content paint */}
    {adsenseId && (
      <script
        is:inline
        async
        defer
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
        crossorigin="anonymous"></script>
    )}

    {/* Pinterest save button — deferred, ~14KB, loads after paint */}
    <script is:inline async defer data-pin-hover="true" src="https://assets.pinterest.com/js/pinit.js"></script>
  </body>
</html>
