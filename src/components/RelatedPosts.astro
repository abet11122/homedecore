---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';
import SectionHead from './SectionHead.astro';
import { categoryName, isPublished, tagSlug } from '../site';

interface Props {
  category: string;
  currentId: string;
  tags?: string[];
  limit?: number;
}

const { category, currentId, tags = [], limit = 3 } = Astro.props;

const all = (await getCollection('posts')).filter(isPublished);

const currentTags = new Set(tags.map(tagSlug));
const related = all
  .filter((p) => p.id !== currentId)
  .map((post) => {
    const sharedTags = (post.data.tags ?? []).filter((tag) => currentTags.has(tagSlug(tag))).length;
    const score = sharedTags * 10 + (post.data.category === category ? 2 : 0);
    return { post, score };
  })
  .sort((a, b) => b.score - a.score || b.post.data.publishDate.getTime() - a.post.data.publishDate.getTime())
  .slice(0, limit)
  .map(({ post }) => post);
---

{related.length > 0 && (
  <section class="mt-16 border-t border-rule pt-10" aria-labelledby="related-heading">
    <SectionHead
      id="related-heading"
      kicker="Related reading"
      title="Continue with a connected idea"
      href={`/category/${category}/`}
    />

    <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((post) => (
        <PostCard post={post} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" />
      ))}
    </div>
  </section>
)}
