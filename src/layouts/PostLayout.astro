---
import Layout from './Layout.astro';
import Img from '../components/Img.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PinterestButton from '../components/PinterestButton.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, categoryName, formatDate } from '../site';

interface Props {
  post: any;
  headings: Array<{ depth: number; text: string; slug: string }>;
  minutes: number;
}

const { post, headings, minutes } = Astro.props;
const d = post.data;
---

<Layout
  title={d.title}
  description={d.description}
  image={d.pinImage}
  type="article"
  publishDate={d.publishDate.toISOString()}
  updatedDate={d.updatedDate?.toISOString()}
>
  <div id="progress" aria-hidden="true"></div>

  <article class="wrap pt-8 lg:pt-12">
    <div class="mx-auto max-w-reading">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: categoryName(d.category), href: `/category/${d.category}/` },
          { label: d.title },
        ]}
      />

      <header class="mt-8">
        <a href={`/category/${d.category}/`} class="eyebrow hover:text-clay-deep">
          {categoryName(d.category)}
        </a>

        <h1 class="mt-4 font-display text-[2.125rem] leading-[1.12] text-ink sm:text-[2.75rem] lg:text-[3.25rem]">
          {d.title}
        </h1>

        <p class="mt-5 font-display text-lg italic leading-relaxed text-ink-60 sm:text-xl">
          {d.description}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-rule py-4 text-xs uppercase tracking-[0.1em] text-ink-40">
          <span class="text-ink-60">{SITE.author}</span>
          <span aria-hidden="true" class="text-ink-20">/</span>
          <time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)}</time>
          {d.updatedDate && (
            <>
              <span aria-hidden="true" class="text-ink-20">/</span>
              <span>Updated {formatDate(d.updatedDate)}</span>
            </>
          )}
          <span aria-hidden="true" class="text-ink-20">/</span>
          <span>{minutes} min read</span>
        </div>
      </header>
    </div>

    {/* Hero image sits below the headline: the H1 paints first, which keeps LCP text-fast */}
    <figure class="mt-9 lg:mt-12">
      <div class="frame aspect-[16/10] sm:aspect-[2/1]">
        <Img
          src={d.heroImage}
          alt={d.title}
          width={1280}
          height={640}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 1280px) 1180px, 100vw"
        />
      </div>
    </figure>

    <div class="mx-auto mt-10 max-w-reading lg:mt-14">
      {d.affiliateDisclosure && <AffiliateDisclosure />}

      <TableOfContents headings={headings} />

      <AdSlot placement="in-article-top" class="my-10" />

      <div class="article">
        <slot />
      </div>

      {d.tags && d.tags.length > 0 && (
        <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-rule pt-7">
          <span class="eyebrow-muted mr-1">Filed under</span>
          {d.tags.map((tag: string) => (
            <span class="border border-rule px-3 py-1 text-xs text-ink-60">{tag}</span>
          ))}
        </div>
      )}

      <AdSlot placement="in-article-mid" class="my-12" />

      <section class="mt-14 border-t border-rule pt-10">
        <div class="text-center">
          <p class="eyebrow-muted">Save it</p>
          <h2 class="mt-3 font-display text-2xl text-ink sm:text-3xl">Pin this for your board</h2>
          <p class="mx-auto mt-3 max-w-md text-[0.9375rem] leading-relaxed text-ink-60">
            Tap the image to save it to Pinterest and come back to it when you are ready to start.
          </p>
        </div>
        <div class="mt-8">
          <PinterestButton image={d.pinImage} title={d.title} description={d.description} />
        </div>
      </section>

      <AuthorBox publishDate={d.publishDate} updatedDate={d.updatedDate} />
    </div>

    <div class="mx-auto max-w-[72rem]">
      <AdSlot placement="before-related" class="mt-14" />
      <RelatedPosts category={d.category} currentId={post.id} />
    </div>
  </article>

  {/* Sticky mobile anchor ad. Body gets bottom padding so it never covers text. */}
  <div class="anchor-ad" slot="after-footer">
    <AdSlot placement="anchor" />
  </div>
</Layout>

<style is:global>
  /* Room for the mobile anchor ad */
  @media (max-width: 767px) {
    body {
      padding-bottom: 60px;
    }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('progress');
    var article = document.querySelector('.article');
    if (!bar || !article) return;
    function update() {
      var start = article.offsetTop;
      var total = article.offsetHeight - window.innerHeight;
      var done = window.scrollY - start;
      var pct = total > 0 ? Math.min(100, Math.max(0, (done / total) * 100)) : 0;
      bar.style.width = pct + '%';
    }
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
    update();
  })();
</script>
