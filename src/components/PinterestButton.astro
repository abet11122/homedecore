---
import Img from './Img.astro';
import { SITE } from '../site';
import { localImage } from '../images';

/**
 * The vertical 2:3 pin image with a Save button.
 *
 * Use the production canonical so saved pins never carry tracking parameters,
 * section fragments or a preview hostname. The link also works without JS.
 */
interface Props {
  image: string;
  title: string;
  description: string;
}

const { image, title, description } = Astro.props;
const generated = image.startsWith('/images/generated/');

const mediaUrl = new URL(localImage(image), Astro.site ?? SITE.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const shareUrl = new URL('https://pinterest.com/pin/create/button/');
shareUrl.search = new URLSearchParams({
  url: canonical,
  media: mediaUrl,
  description: `${title} — ${description}`,
}).toString();
---

<figure class="mx-auto max-w-sm">
  <div class="group relative">
    <div class:list={['frame', generated ? 'aspect-[3/2]' : 'aspect-[2/3]']}>
      <Img src={image} alt={title} width={600} height={generated ? 400 : 900} sizes="(min-width: 640px) 384px, 90vw" />
    </div>

    <a
      href={shareUrl.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Save ${title} to Pinterest (opens in a new tab)`}
      class="pin-save absolute right-3 top-3 inline-flex min-h-11 items-center gap-2 rounded-full bg-[#E60023] px-4 py-2.5 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-[#bd001d]"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345c-.091.379-.293 1.194-.333 1.361-.052.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.608 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146A12 12 0 0 0 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"
        ></path>
      </svg>
      Save
    </a>
  </div>

  <figcaption class="mt-3 text-center text-xs text-ink-40">
    {generated ? 'AI-generated interior illustration.' : 'Illustrative stock photography.'} Save this decorating idea for later.
  </figcaption>
</figure>
