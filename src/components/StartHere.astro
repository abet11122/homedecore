---
const projects = [
  { number: '01', room: 'Living room', title: 'Make the room feel connected', text: 'Find the right rug footprint before you buy.', href: '/post/living-room-rug-layout-checklist/', detail: 'A measuring checklist' },
  { number: '02', room: 'Rental living', title: 'Give everyday things a home', text: 'Create an entryway without drilling for hooks.', href: '/post/rental-entryway-without-wall-hooks/', detail: 'Three practical layouts' },
  { number: '03', room: 'Bedroom', title: 'Get the finishing details right', text: 'Measure curtains with fewer surprises.', href: '/post/bedroom-curtain-measuring-checklist/', detail: 'A step-by-step worksheet' },
];
---
<section class="start-here wrap" aria-labelledby="start-heading">
  <div class="start-heading">
    <div><p class="eyebrow">Small changes, considered</p><h2 id="start-heading">Start with one corner.</h2></div>
    <p>A more comfortable home starts with the space you use every day. Pick a project and make it yours.</p>
  </div>
  <div class="project-grid">
    {projects.map(project => <a class="project-card" href={project.href}>
      <div class="project-top"><span class="eyebrow">{project.room}</span><span class="project-number" aria-hidden="true">{project.number}</span></div>
      <h3>{project.title}</h3><p>{project.text}</p>
      <div class="project-bottom"><span>{project.detail}</span><span aria-hidden="true">↗</span></div>
    </a>)}
  </div>
</section>
<style>
  .start-here { margin-block: clamp(3rem, 7vw, 6rem); }
  .start-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.8rem; }
  .start-heading h2 { font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.15; margin-top: .7rem; }
  .start-heading > p { max-width: 23rem; color: #665e54; }
  .project-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .project-card { display: flex; flex-direction: column; padding: clamp(1.35rem, 3vw, 2rem); background: #edece4; border: 1px solid #d7d9cd; border-radius: .75rem; color: #243e34; transition: background .2s, border-color .2s; }
  .project-card:nth-child(2) { background: #f1e8dd; border-color: #e2d4c4; }
  .project-card:nth-child(3) { background: #e9eceb; border-color: #d2dcda; }
  .project-card:hover { background: #fffdf8; border-color: #536b5a; }
  .project-card:focus-visible { outline: 3px solid #245245; outline-offset: 4px; }
  .project-top, .project-bottom { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .project-number { font-family: Georgia,serif; font-size: 2rem; color: #798575; }
  h3 { font-size: 1.65rem; line-height: 1.2; max-width: 17ch; margin: 1.4rem 0 .8rem; }
  .project-card > p { color: #5f665d; margin-bottom: 1.5rem; }
  .project-bottom { margin-top: auto; padding-top: 1.1rem; border-top: 1px solid #243e3425; font-size: .8rem; }
  .project-bottom > span:last-child { font-size: 1.5rem; }
  @media(max-width: 700px) { .start-heading { display: block; } .start-heading > p { margin-top: 1rem; } .project-grid { grid-template-columns: 1fr; } h3 { max-width: none; margin-top: .8rem; } }
</style>
