---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import { CATEGORIES, PRIMARY_CATEGORIES, categoryName } from '../site';
const posts = (await getCollection('posts')).sort((a,b) => b.data.publishDate.getTime()-a.data.publishDate.getTime());
const featured = posts.find(p => p.data.featured) ?? posts[0];
const picks = posts.filter(p => ['small-bedroom-ideas-that-look-expensive','apartment-decor-ideas-budget','renter-friendly-wall-decor-ideas'].includes(p.id));
---
<Layout title="Home Decor Ideas for Beautiful, Livable Spaces" description="Find home decor ideas for small bedrooms, living rooms, rentals and more. Explore practical styling guides, save your favorites and plan your next room refresh.">
  <div class="home-note">A little inspiration. A home that feels like you.</div>
  <section class="wrap home-hero">
    <div class="home-hero-copy">
      <p class="eyebrow">Beautiful spaces. Everyday living.</p>
      <h1>Make room for<br /><em>the life you love.</em></h1>
      <p>Home decor ideas for real rooms, real budgets, and your own kind of beautiful. Find the little changes that make you love coming home.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="#find-ideas">Find your inspiration ↗</a><a class="quiet-link" href="/saved/">♡ My saved ideas</a></div>
      <div class="hero-footnote"><span>{posts.length} decorating guides</span><span>Room-by-room inspiration</span></div>
    </div>
    {featured && <a class="hero-feature" href={`/post/${featured.id}/`}>
      <Img src={featured.data.heroImage} alt={featured.data.title} width={900} height={1000} loading="eager" fetchpriority="high" sizes="(min-width: 900px) 48vw, 100vw" />
      <span class="feature-label">The editor’s pick</span>
      <div class="feature-caption"><span>{categoryName(featured.data.category)}</span><h2>{featured.data.title}</h2><span class="feature-arrow" aria-hidden="true">↗</span></div>
    </a>}
  </section>
  <section class="wrap room-section" aria-labelledby="rooms-title">
    <div class="home-section-head"><div><p class="eyebrow">Start somewhere you love</p><h2 id="rooms-title">Which room is on your mind?</h2></div><a class="quiet-link" href="/tags/">Explore all topics ↗</a></div>
    <div class="room-grid">{PRIMARY_CATEGORIES.map(c => <a href={`/category/${c.slug}/`} class="room-card"><div class="frame"><Img src={c.image} alt={`${c.name} decorating inspiration`} width={320} height={380} sizes="(min-width: 900px) 15vw, 45vw" /></div><span>{c.name}<span aria-hidden="true">↗</span></span></a>)}</div>
  </section>
  <section class="discovery-section" id="find-ideas" aria-labelledby="ideas-title">
    <div class="wrap">
      <div class="home-section-head"><div><p class="eyebrow">Your next “I could do that” moment</p><h2 id="ideas-title">Find your next home idea</h2></div><a class="quiet-link" href="/search/">Search all guides ↗</a></div>
      <div class="idea-filters" aria-label="Filter ideas by room"><button data-room="all" aria-pressed="true">All ideas</button>{CATEGORIES.map(c => <button data-room={c.slug} aria-pressed="false">{c.name}</button>)}</div>
      <p id="idea-count" class="idea-count" aria-live="polite">Explore {posts.length} decorating guides.</p>
      <div class="ideas-grid">{posts.map(post => <div data-idea-room={post.data.category}><PostCard post={post} /></div>)}</div>
      <button id="more-ideas" class="btn btn-primary more-ideas" hidden>Discover more ideas ↓</button>
    </div>
  </section>
  <div class="wrap"><AdSlot placement="feed" class="my-12" /></div>
  <section class="wrap budget-section" aria-labelledby="budget-title"><div class="home-section-head"><div><p class="eyebrow">Little changes, lovely results</p><h2 id="budget-title">Big on style. Kind to your budget.</h2></div><a class="quiet-link" href="/category/renter/">Explore renter-friendly ideas ↗</a></div><div class="grid gap-8 md:grid-cols-3">{picks.map(post => <PostCard post={post} />)}</div></section>
  <div class="wrap my-16"><Newsletter /></div>
</Layout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-room]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-idea-room]')];
  const more = document.querySelector<HTMLButtonElement>('#more-ideas')!;
  let active = 'all'; let limit = 9;
  function render() {
    const matching = cards.filter(card => active === 'all' || card.dataset.ideaRoom === active);
    cards.forEach(card => { card.hidden = true; });
    matching.slice(0,limit).forEach(card => { card.hidden = false; });
    more.hidden = matching.length <= limit;
    document.querySelector('#idea-count')!.textContent = `Showing ${Math.min(limit,matching.length)} of ${matching.length} guides`;
  }
  filters.forEach(button => button.addEventListener('click', () => {
    active = button.dataset.room!; limit = 9;
    filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button))); render();
  }));
  more.addEventListener('click', () => { const previous = limit; limit += 9; render(); cards.filter(card => active === 'all' || card.dataset.ideaRoom === active)[previous]?.querySelector('a')?.focus({preventScroll:true}); });
  render();
</script>
