---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import { normalizeSearch } from '../search';
import { CATEGORIES, categoryName, formatDateShort, isPublished, postPath } from '../site';

const posts = (await getCollection('posts')).filter(isPublished).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

---

<Layout
  title="Search"
  description="Search every story in the archive by title, room or tag."
  noindex
>
  <div class="wrap py-12 lg:py-16" data-story-browser="search">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow-muted">The complete archive</p>
      <h1 class="mt-4 font-display text-4xl leading-tight text-ink sm:text-5xl">Find your next room idea</h1>
      <p class="mt-4 text-ink-60">
        {posts.length} stories across {CATEGORIES.length} rooms. Start typing to filter.
      </p>

      <div class="relative mt-8">
        <svg
          class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-20"
          width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <label for="q" class="sr-only">Search stories</label>
        <input
          id="q"
          type="search"
          autocomplete="off"
          placeholder="Try “small bedroom”, “shelving”, “terracotta”…"
          class="field py-4 pl-12 text-center text-lg"
        />
      </div>

      <div class="mt-6 flex flex-wrap justify-center gap-2">
        <button type="button" data-room="" aria-pressed="true" class="chip is-active">All</button>
        {CATEGORIES.map((c) => (
          <button type="button" data-room={c.slug} aria-pressed="false" class="chip">{c.name}</button>
        ))}
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-b border-rule pb-4">
    <p id="count" data-result-count class="text-eyebrow font-semibold uppercase text-ink-40" role="status" aria-live="polite" aria-atomic="true">
      {posts.length} stories
    </p>
    <button type="button" data-reset-filters disabled class="reset-filters">Clear filters</button>
    </div>
    <noscript><p class="mt-5 text-ink-60">All stories are listed below. Enable JavaScript to search and filter them.</p></noscript>

    <div id="results" class="mt-10 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="result group" data-room={post.data.category} data-search-text={normalizeSearch([post.data.title, post.data.description, categoryName(post.data.category), ...(post.data.tags ?? [])].join(' '))}>
          <a href={postPath(post)} class="block">
            <div class="frame aspect-[4/5]">
              <Img
                src={post.data.heroImage}
                alt={post.data.heroImageAlt ?? post.data.title}
                width={640}
                height={800}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
              />
            </div>
            <p class="eyebrow mt-5">{categoryName(post.data.category)}</p>
            <h2 class="mt-2.5 font-display text-[1.3rem] leading-[1.25] text-ink transition-colors group-hover:text-clay">
              {post.data.title}
            </h2>
            <p class="clamp-2 mt-2.5 text-[0.9375rem] leading-relaxed text-ink-60">
              {post.data.description}
            </p>
            <p class="mt-3.5 text-xs text-ink-40">{formatDateShort(post.data.publishDate)}</p>
          </a>
        </article>
      ))}
    </div>

    <p id="empty" data-empty-results hidden class="py-20 text-center">
      <span class="block font-display text-2xl text-ink">No stories match that.</span>
      <span class="mt-3 block text-ink-60">Try a broader word, or browse a room from the menu.</span>
    </p>
  </div>
</Layout>

<style>
  .chip {
    @apply min-h-11 rounded-full border border-rule px-3.5 py-2 text-xs uppercase tracking-[0.08em] text-ink-60 transition-colors;
  }
  .chip:hover {
    @apply border-ink text-ink;
  }
  .chip.is-active {
    @apply border-ink bg-ink text-paper;
  }
</style>

<script>
  import { initStoryFilters } from '../scripts/story-filters';
  initStoryFilters('search');
</script>
