---
import { imageAsset, localImage } from '../images';
/**
 * Responsive image.
 *
 * `src` accepts either a bare Unsplash photo id ("photo-1600210492486-...")
 * or any absolute URL. For Unsplash we append `auto=format`, which makes their
 * CDN negotiate AVIF → WebP → JPEG from the browser's Accept header, so modern
 * browsers get AVIF and everything else falls back automatically.
 *
 * width/height are always emitted so the browser reserves the box before the
 * bytes arrive — this is what keeps CLS at zero.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
} = Astro.props;

const asset = imageAsset(src);
const candidates = asset?.variants.filter((v) => v.width <= width * 2);
const variants = candidates?.length ? candidates : asset?.variants.slice(0, 1);
const srcset = variants?.map((v) => `${v.src} ${v.width}w`).join(', ');
const finalSrc = variants?.at(-1)?.src ?? localImage(src);
---

<img
  src={finalSrc}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  style={`aspect-ratio:${width}/${height};object-fit:cover`}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={fetchpriority}
  class={className}
/>
