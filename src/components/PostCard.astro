---
import Img from './Img.astro';
import SaveIdea from './SaveIdea.astro';
import { categoryName, formatDateShort } from '../site';

interface Props {
  post: any;
  /** 'default' = stacked card, 'wide' = image beside text, 'compact' = small thumb row */
  variant?: 'default' | 'wide' | 'compact';
  eager?: boolean;
  sizes?: string;
}

const { post, variant = 'default', eager = false, sizes } = Astro.props;
const href = `/post/${post.id}/`;
const d = post.data;
---

{variant === 'default' && (
  <article class="reveal group idea-card">
    <a href={href} class="card-lift block">
      <div class="frame aspect-[4/5]">
        <Img
          src={d.heroImage}
          alt={d.title}
          width={640}
          height={800}
          loading={eager ? 'eager' : 'lazy'}
          sizes={sizes ?? '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw'}
        />
      </div>
      <p class="eyebrow mt-5 border-t border-rule pt-4">{categoryName(d.category)}</p>
      <h3 class="mt-2.5 font-display text-title-lg text-ink transition-colors duration-250 group-hover:text-clay">
        {d.title}
      </h3>
      <p class="clamp-2 mt-3 text-[0.9375rem] leading-relaxed text-ink-60">{d.description}</p>
      <p class="mt-4 text-xs uppercase tracking-[0.1em] text-ink-40">{formatDateShort(d.publishDate)}</p>
    </a>
    <SaveIdea id={post.id} />
  </article>
)}

{variant === 'wide' && (
  <article class="reveal group grid gap-6 sm:grid-cols-12 sm:items-center">
    <a href={href} class="card-lift sm:col-span-5">
      <div class="frame aspect-[4/3]">
        <Img
          src={d.heroImage}
          alt={d.title}
          width={560}
          height={420}
          loading={eager ? 'eager' : 'lazy'}
          sizes={sizes ?? '(min-width: 640px) 40vw, 90vw'}
        />
      </div>
    </a>
    <div class="sm:col-span-7">
      <div class="flex items-center gap-2.5">
        <span class="h-px w-5 bg-clay"></span>
        <p class="eyebrow">{categoryName(d.category)}</p>
      </div>
      <h3 class="mt-3 font-display text-display-4 text-ink">
        <a href={href} class="transition-colors duration-250 group-hover:text-clay">{d.title}</a>
      </h3>
      <p class="clamp-2 mt-3 leading-relaxed text-ink-60">{d.description}</p>
      <p class="mt-4 text-xs uppercase tracking-[0.1em] text-ink-40">{formatDateShort(d.publishDate)}</p>
    </div>
  </article>
)}

{variant === 'compact' && (
  <article class="group flex items-start gap-4">
    <a href={href} class="shrink-0">
      <div class="frame aspect-square w-20 sm:w-24">
        <Img src={d.heroImage} alt={d.title} width={192} height={192} sizes="96px" />
      </div>
    </a>
    <div class="min-w-0">
      <p class="eyebrow-muted">{categoryName(d.category)}</p>
      <h3 class="mt-1.5 font-display text-title-sm text-ink">
        <a href={href} class="transition-colors group-hover:text-clay">{d.title}</a>
      </h3>
      <p class="mt-1.5 text-xs text-ink-40">{formatDateShort(d.publishDate)}</p>
    </div>
  </article>
)}
