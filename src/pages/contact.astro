---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../site';
---

<Layout
  title="Contact"
  description={`Get in touch with ${SITE.name} for editorial notes, corrections, or partnership enquiries.`}
>
  <header class="border-b border-rule bg-sand/50">
    <div class="wrap py-12 lg:py-20">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
      <p class="eyebrow mt-10 text-clay">Get in touch</p>
      <h1 class="mt-4 max-w-3xl font-display text-[2.75rem] leading-[1.08] text-ink sm:text-6xl">
        A conversation starts here.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-60">
        For editorial notes, corrections, partnership enquiries and privacy requests, use the form below or explore the archive.
      </p>
    </div>
  </header>

  <section class="wrap grid gap-12 py-14 lg:grid-cols-12 lg:gap-16 lg:py-20" aria-labelledby="contact-heading">
    <div class="lg:col-span-5">
      <p class="eyebrow text-clay">Send a message</p>
      <h2 id="contact-heading" class="mt-4 font-display text-3xl leading-tight text-ink sm:text-4xl">
        We read every note.
      </h2>
      <p class="mt-5 max-w-md leading-relaxed text-ink-60">
        Whether you have spotted an error, want to suggest a topic, or have a partnership idea — we would love to hear from you.
      </p>
    </div>
    <div class="lg:col-span-7">
      <form
        name="contact"
        method="POST"
        action="/contact/?sent=1"
        class="grid gap-6"
        aria-label="Contact form"
      >
        <div>
          <label for="contact-name" class="block text-sm font-semibold text-ink mb-2">Name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full border border-rule bg-white px-4 py-3 text-sm text-ink placeholder:text-ink-40 focus:outline-none focus:ring-2 focus:ring-clay/40"
            placeholder="Your name"
          />
        </div>
        <div>
          <label for="contact-email" class="block text-sm font-semibold text-ink mb-2">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full border border-rule bg-white px-4 py-3 text-sm text-ink placeholder:text-ink-40 focus:outline-none focus:ring-2 focus:ring-clay/40"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label for="contact-message" class="block text-sm font-semibold text-ink mb-2">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="w-full border border-rule bg-white px-4 py-3 text-sm text-ink placeholder:text-ink-40 focus:outline-none focus:ring-2 focus:ring-clay/40 resize-y"
            placeholder="What would you like to say?"
          ></textarea>
        </div>
        <button
          type="submit"
          class="self-start bg-clay px-7 py-3 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:bg-clay-deep"
        >
          Send message
        </button>
      </form>
    </div>
  </section>

  <section class="wrap grid gap-12 py-14 border-t border-rule lg:grid-cols-12 lg:gap-16 lg:py-20" aria-labelledby="meanwhile-heading">
    <div class="lg:col-span-5">
      <p class="eyebrow text-clay">Explore</p>
      <h2 id="meanwhile-heading" class="mt-4 font-display text-3xl leading-tight text-ink sm:text-4xl">
        There is plenty to read.
      </h2>
    </div>
    <div class="divide-y divide-rule border-y border-rule lg:col-span-7">
      <a href="/search/" class="group flex items-center justify-between gap-5 py-6">
        <span><strong class="block font-display text-xl font-normal text-ink group-hover:text-clay">Search the archive</strong><span class="mt-1 block text-sm text-ink-60">Find ideas for the space you are working on.</span></span>
        <span class="text-2xl text-clay" aria-hidden="true">↗</span>
      </a>
      <a href="/tags/" class="group flex items-center justify-between gap-5 py-6">
        <span><strong class="block font-display text-xl font-normal text-ink group-hover:text-clay">Browse topics</strong><span class="mt-1 block text-sm text-ink-60">Explore style, storage, colour and more.</span></span>
        <span class="text-2xl text-clay" aria-hidden="true">↗</span>
      </a>
      <a href="/rss.xml" class="group flex items-center justify-between gap-5 py-6">
        <span><strong class="block font-display text-xl font-normal text-ink group-hover:text-clay">Follow the feed</strong><span class="mt-1 block text-sm text-ink-60">Get each new story in your RSS reader.</span></span>
        <span class="text-2xl text-clay" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
